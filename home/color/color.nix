# [colors from Tempus Night theme]
# (https://protesilaos.com/tempus-night/).
rec {
  background     = normal.black;
  alt-background = bright.black;
  foreground     = bright.white;
  alt-foreground = normal.white;
  cursor         = foreground;
  normal = {
    black   = "#1a1a1a";
    red     = "#fb7e8e";
    green   = "#52ba40";
    yellow  = "#b0a800";
    blue    = "#5aaaf2";
    magenta = "#ee80c0";
    cyan    = "#1db5c3";
    white   = "#c4bdaf";
  };
  bright = {
    black   = "#18143d";
    red     = "#f69d6a";
    green   = "#88c400";
    yellow  = "#d7ae00";
    blue    = "#8cb4f0";
    magenta = "#de99f0";
    cyan    = "#00ca9a";
    white   = "#e0e0e0";
  };
}
